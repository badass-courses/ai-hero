# Ops only. Never load this schema from env:check or prebuild.
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_TOKEN, allowAppAuth=false)
# @defaultSensitive=true @defaultRequired=true
# ---

# @type=opServiceAccountToken @internal
OP_TOKEN=

# Caller supplies the vault; no desktop app authentication or default vault.
# @type=string(minLength=1) @internal
OP_VAULT=

# @type=url
DATABASE_URL=op("op://${OP_VAULT}/DATABASE_URL/password")
