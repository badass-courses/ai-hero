# @defaultSensitive=true @defaultRequired=false @currentEnv=$VARLOCK_ENV
# ---

# Read-only front-desk RPC bearer key. Unset keeps the route disabled (503).
# @sensitive @type=string
FRONT_DESK_API_KEY=

# front-desk's base URL. C5 is priced in-process; front-desk serves its policy
# (GET /api/pricing/policy) and binding quotes (POST /api/binding-quotes) as
# data. Unset leaves C5 held: no C5 price is shown as a charge or charged.
# @sensitive=false @type=url
FRONT_DESK_URL=

# Bearer for front-desk's pricing policy route. Server only. Without it C5 is
# held, and C5 team invoicing stays off.
# @sensitive @type=string
FRONT_DESK_PRICING_TOKEN=

# Bearer for front-desk's binding-quotes route, scoped apart from the pricing
# token because it returns customer quotes. Server only. Without it a signed-in
# C5 checkout holds instead of charging the formula price.
# @sensitive @type=string
FRONT_DESK_QUOTES_TOKEN=

# C5 kill switch. "true" closes C5 display, checkout and team invoices; C5
# never falls back to the legacy price. Any value but "false" closes it, so a
# typo fails closed. Takes effect on the next deploy.
# @sensitive=false @type=string
AIH_C5_PRICING_DISABLED=

# When paid C5 purchases started saving their pricing decisions (ISO-8601
# instant, e.g. 2030-01-01T00:00:00Z). A C5 purchase before it, held by anyone
# in a Crash Course purchase's transfer chain, spends that credit. Unset holds
# the price for any buyer whose chain has a C5 purchase.
# @sensitive=false @type=string
AIH_C5_DECISION_CUTOVER_AT=

# Inngest event ingestion credential. Real keys are substantially longer than
# placeholders. Keep the value in Vercel or a gitignored local env file.
# @required=forEnv(production) @sensitive @type=string(minLength=if(forEnv(production), 32, 1))
# @docs(https://www.inngest.com/docs/events/creating-an-event-key)
INNGEST_EVENT_KEY=

# Inngest request signing and Events API credential. Production and test keys
# use explicit signkey environment prefixes.
# @required=forEnv(production) @sensitive
# @type=string(minLength=if(forEnv(production), 32, 1), matches=if(forEnv(production), "^signkey-prod-", ".*"))
# @docs(https://www.inngest.com/docs/platform/signing-keys)
INNGEST_SIGNING_KEY=
