exports[`WelcomeWorkshopEmailForTeam > gives a bulk buyer the invite link and the seat rule 1`] = `"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="en"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/></head><body style="background-color:#f6f9fc;font-family:-apple-system,BlinkMacSystemFont,&quot;Segoe UI&quot;,Roboto,Oxygen-Sans,Ubuntu,Cantarell,&quot;Helvetica Neue&quot;,sans-serif;padding:20px 0"><!--$--><!--html--><!--head--><div style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0">Welcome! Manage your 7 cohort seats<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><!--body--><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:580px;background-color:#ffffff;border:1px solid #dfe3e8;border-radius:12px;margin:0 auto;padding:0"><tbody><tr style="width:100%"><td><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding:32px"><tbody><tr><td><h1 style="color:#1a202c;font-size:28px;font-weight:bold;line-height:36px;text-align:center;margin:0 0 30px">Your Team is Registered for <!-- -->Team Workshop<!-- -->! 🎉</h1><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin-top:24px"><tbody><tr><td><p style="font-size:16px;line-height:26px;margin:0 0 16px;color:#333333">Hi there,</p><p style="font-size:16px;line-height:26px;margin:0 0 16px;color:#333333">You&#x27;ve purchased <strong>7</strong> <!-- -->seats<!-- --> to<!-- --> <strong>Team Workshop</strong>.</p><p style="font-size:16px;line-height:26px;margin:0 0 16px;color:#333333">Share this link with your team. Each person signs in through it to claim a seat:</p><p style="font-size:16px;line-height:26px;margin:0 0 16px;color:#333333"><a href="https://www.aihero.dev?code=bulk-abc" style="color:#007bff;text-decoration-line:none;text-decoration:underline" target="_blank">https://www.aihero.dev?code=bulk-abc</a></p><p style="font-size:16px;line-height:26px;margin:0 0 16px;color:#333333">Each seat is for one person and can&#x27;t be moved to someone else later. If you&#x27;re joining too, use the same link to claim your own seat.</p><p style="font-size:16px;line-height:26px;margin:0 0 16px;color:#333333">You can see who has claimed a seat, and invite a manager, at<!-- --> <a href="https://www.aihero.dev/team" style="color:#007bff;text-decoration-line:none;text-decoration:underline" target="_blank">www.aihero.dev/team</a>.</p><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="text-align:center;margin-top:20px"><tbody><tr><td><a href="#start" style="color:#ffffff;text-decoration-line:none;background-color:#007bff;padding:12px 20px;text-decoration:none;border-radius:5px;display:inline-block;font-weight:bold" target="_blank">Get Started with <!-- -->Team Workshop</a></td></tr></tbody></table></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin-top:24px"><tbody><tr><td><p style="font-size:14px;line-height:22px;margin:0 0 16px;color:#555555">Need an invoice? Visit your<!-- --> <a href="https://www.aihero.dev/invoices" style="color:#007bff;text-decoration-line:none;text-decoration:underline" target="_blank">invoices page</a>. Questions? Contact<!-- --> <a href="mailto:support@aihero.dev" style="color:#007bff;text-decoration-line:none;text-decoration:underline" target="_blank">support@aihero.dev</a>.</p></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin-top:24px"><tbody><tr><td><p style="font-size:16px;line-height:26px;margin:0 0 16px;color:#333333">Thank you!</p><p style="font-size:16px;line-height:26px;margin:0 0 16px;color:#333333">The <!-- -->AI Hero<!-- --> Team</p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"`;
