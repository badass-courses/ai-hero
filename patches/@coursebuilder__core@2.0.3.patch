+/**
+ * Legacy redirect contract. New money paths should use `stripeCheckoutResult`
+ * so provider failures cannot be mistaken for successful checkout redirects.
+ */
+export async function stripeCheckout(input: {
+	params: CheckoutParams
+	config: PaymentsProviderConsumerConfig
+	adapter?: CourseBuilderAdapter
+}): Promise<any> {
+	const result = await stripeCheckoutResult(input)
+	if (result.kind === 'success') {
+		return { redirect: result.redirect, status: 303 }
+	}
+	if (input.config.errorRedirectUrl) {
+		return { redirect: input.config.errorRedirectUrl, status: 303 }
+	}
+	return {
+		status: 500,
+		body: { error: true, message: result.failure.code },
 	}
 }
